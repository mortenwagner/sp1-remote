/*
 * ADC channels for the four faders and the battery divider. Channels 0 and
 * 1 (the button ladders) come from the board file; these five extend the
 * same list, and firmware/src/board_io.c consumes ALL SEVEN BY INDEX via
 * DT_PATH(zephyr_user). Reordering this list silently reassigns faders.
 *
 * Vendored from sp1-tape-looper firmware/app.overlay (MIT). The gain,
 * reference and acquisition time must stay identical to the board file's
 * channels 0-1: the button decode thresholds in board_io.c are calibrated
 * raw values under exactly this configuration.
 *
 * Note the SP-1 has no MIDI UART. The TRS jack's MIDI line is bit-banged on
 * P0.23 (see firmware/src/midi_trs.c), so nothing here describes it.
 */

/ {
	/* USB MIDI 2 device, alongside the CDC console: a composite. Node
	 * shape from ericlewis/sp1-midi app.overlay (MIT). One group is
	 * enough; the surface is a single controller. */
	usb_midi: usb_midi {
		compatible = "zephyr,midi2-device";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		label = "SP-1 Remote";

		midi_group@0 {
			reg = <0 1>;
			protocol = "midi1-up-to-128b";
			label = "Controls";
		};
	};
};

/* ---- TRS MIDI out: hardware UARTE, 31250 baud, TX only ----
 *
 * Data on the TIP, driven by P0.20. This follows bnjreece/feldd-sp1-firmware,
 * which states the electrical path is HARDWARE-VALIDATED: feldd drives an
 * OP-XY over this jack as TRS Type A with data on the tip at P0.20.
 *
 * That matters more than it sounds. Type A is what the Tiliqua's MIDI-in and
 * a Blokas Midihub both expect, so a PLAIN TRS CABLE works: no adapter, no
 * tip/sleeve swap, no polarity guess.
 *
 * It also replaces a bit-banged GPIO with a peripheral that has its own
 * DMA, which removes three problems at once: the MIDI_INVERT polarity
 * unknown, flash writes stalling the CPU mid-byte, and USB interrupts
 * jittering 32 us bit edges.
 *
 * feldd hedges that P0.17 is the alternative if a scope shows otherwise;
 * that would be a one-line change to the psels below. */
&pinctrl {
	uart1_default: uart1_default {
		group1 { psels = <NRF_PSEL(UART_TX, 0, 20)>; };
	};
	uart1_sleep: uart1_sleep {
		group1 { psels = <NRF_PSEL(UART_TX, 0, 20)>; low-power-enable; };
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <31250>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	channel@2 { reg = <2>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN3>; zephyr,resolution = <12>; };   /* Fader 1 P0.05 */
	channel@3 { reg = <3>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN6>; zephyr,resolution = <12>; };   /* Fader 2 P0.30 */
	channel@4 { reg = <4>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>; zephyr,resolution = <12>; };   /* Fader 3 P0.04 */
	channel@5 { reg = <5>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>; zephyr,resolution = <12>; };   /* Fader 4 P0.31 */
	channel@6 { reg = <6>; zephyr,gain = "ADC_GAIN_1_6"; zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>; zephyr,resolution = <12>; };   /* Battery level P0.28 (divider, per SP-1-dev wiki) */
};
&zephyr_user {
	io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>, <&adc 5>, <&adc 6>;
};
